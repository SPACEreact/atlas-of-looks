{
  "name": "style-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run images:check",
    "build": "tsc -b && vite build",
    "images:check": "node scripts/validate-style-images.mjs",
    "images:sync": "node scripts/sync-style-images.mjs",
    "images:dedupe": "node scripts/fetch-style-images.mjs --dedupe",
    "images:refresh": "node scripts/fetch-style-images.mjs",
    "images:optimize": "node scripts/fetch-style-images.mjs --generated-only",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
